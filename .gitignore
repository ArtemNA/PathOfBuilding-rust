/target/
# synced from pob-ts by tools/sync-data.ps1 (see data.lock)
/data/
# bench / probe outputs
/bench/.results/
/tools/.scratch/
*.log
/tools/luajit-win/target/

# agent worktrees
/.claude/worktrees/
# personal PoB builds copied from Documents (local only)
/builds/pc/
# SG-oracle sandbox: copy of the original PoB runtime (tools/sg-oracle/setup.ps1)
/tools/sg-oracle/runtime/
# LuaJIT truth for builds/pc (tools/lua-corpus/export-real.ts; carries the personal build data)
/builds/pc-fixtures/
# LuaJIT truth for builds/user and builds/corpus (export-real.ts --set user|corpus; re-taken on every upstream update)
/builds/user-fixtures/
/builds/corpus-fixtures/
# personal build copies saved by the U2c oracle scenarios (local only)
/tools/sg-oracle/fixtures/build/*.xml
# U3a: screenshots and states of personal builds (builds/pc): names, stats, passive trees; the tests skip without them
/tools/sg-oracle/fixtures/tree/
# U4: the Calcs tab's oracle (screenshots and states; personal scenes local-<n>)
/tools/sg-oracle/fixtures/calcs/
/tools/sg-oracle/fixtures/audit/calcs-runner-*.json
/tools/sg-oracle/scenes/calcs/local-*.json

# Local only: everything the agents use (plan, rules, prompts, cards, notes) and everything personal
